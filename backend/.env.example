# 复制为 .env 并填入真实值。.env 已被 .gitignore 排除。

# 火山方舟 API Key（必填，用于真实模型调用）
ARK_API_KEY=

# 方舟 API 基础地址
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 实际使用的模型或接入点 ID（例如 glm-5-2-260617 或 ep-xxxx）
ARK_MODEL=

# 数据库连接串（开发默认 SQLite）
AUREL_DATABASE_URL=sqlite:///./aurel.db

# ---- 语音转文字（可选：三个方案三选一，或全部留空）----
# 提供方选择：auto（默认，按就绪顺序自动挑选）/ siliconflow / local / volcengine
ASR_PROVIDER=auto

# 方案一：硅基流动 SenseVoiceSmall 免费档（https://siliconflow.cn 注册创建 API Key）
ASR_SILICONFLOW_API_KEY=

# 方案二：本地 faster-whisper，完全离线免费
#   需先 pip install faster-whisper；首次使用自动下载模型（经下方镜像）
ASR_LOCAL_MODEL=small
HF_ENDPOINT=https://hf-mirror.com

# 方案三：豆包语音录音文件识别极速版（独立于方舟的凭证，https://console.volcengine.com/speech）
# SPEECH_APP_ID=
# SPEECH_ACCESS_TOKEN=

# ---- 第五阶段：访问控制 / 限流 / 稳定性 / 模型实验 ----

# 访问令牌：设置后所有 /api/v1 请求（除健康与状态端点）需携带 Authorization: Bearer <令牌>
# 本地开发留空保持开放；线上部署务必设置强随机值
AUREL_ACCESS_TOKEN=

# 每客户端 IP 每分钟请求上限（0 关闭限流）
AUREL_RATE_LIMIT_PER_MINUTE=120

# 日志级别（DEBUG / INFO / WARNING），日志自动脱敏 Bearer/api_key/token 形态字符串
AUREL_LOG_LEVEL=INFO

# T10 模型实验：按比例把部分真实流量路由到候选模型，观测对比成功率与延迟
# LLM_EXPERIMENT_MODEL=
# LLM_EXPERIMENT_PERCENT=10

# ---- 账户认证：用户名 + 密码（无邮件相关配置）----

# 会话有效期（小时），默认 168 = 7 天
AUREL_SESSION_TTL_HOURS=168

# 生产 HTTPS 部署设为 true，会话 Cookie 将仅经 HTTPS 传输
AUREL_COOKIE_SECURE=
